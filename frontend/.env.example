# Firebase web config overrides.
#
# Every value here is a PUBLIC identifier that ships in the client bundle — none
# of them are secrets, which is why the defaults are committed in
# frontend/src/firebase.js. Set these only to point a build at a different
# Firebase project, or after rotating the web API key, so the change does not
# require editing source.
#
# Copy this file to frontend/.env (gitignored) to override locally. Anything
# left unset falls back to the defaults in frontend/src/firebase.js.
#
# NOTE: cloudbuild.yaml passes no env vars to the frontend build step, so these
# have no effect on the deployed site unless that build step is updated too.

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Points the frontend at a backend other than the /api proxy (see firebase.json).
# VITE_API_URL=
